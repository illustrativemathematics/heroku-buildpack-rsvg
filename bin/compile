#!/usr/bin/env bash
# bin/compile <BUILD_DIR> <CACHE_DIR> <ENV_DIR>

# Abort on errors!
set -eo pipefail

# Output helpers
BIN_DIR=$(cd $(dirname $0); pwd) # absolute path
source $BIN_DIR/utils

# given variables
BUILD_DIR=$1
CACHE_DIR=$2
ENV_DIR=$3

RSVG_DIR="$BIN_DIR/../rsvg"
STACK_BINARY="$RSVG_DIR/$STACK/rsvg-convert"

# Pick the rsvg-convert binary built for this stack
build-step "Installing rsvg-convert for stack: ${STACK:-unknown}"
if [ -z "$STACK" ] || [ ! -f "$STACK_BINARY" ]; then
    build-warn "No rsvg-convert binary for stack '${STACK:-unset}'."
    build-warn "Supported stacks: $(ls -d $RSVG_DIR/*/ | xargs -n1 basename | tr '\n' ' ')"
    exit 1
fi

mkdir -p $BUILD_DIR/bin
cp "$STACK_BINARY" $BUILD_DIR/bin/rsvg-convert
chmod +x $BUILD_DIR/bin/rsvg-convert

# Make sure the binary actually runs on this stack (missing shared libraries
# would otherwise only show up at runtime)
build-step "Testing rsvg-convert"
TEST_OUTPUT=$(mktemp -d)/test.png
if ! $BUILD_DIR/bin/rsvg-convert --version \
    || ! $BUILD_DIR/bin/rsvg-convert -f png -o "$TEST_OUTPUT" "$RSVG_DIR/test.svg" \
    || [ ! -s "$TEST_OUTPUT" ]; then
    build-warn "rsvg-convert failed to run on $STACK"
    ldd $BUILD_DIR/bin/rsvg-convert | grep 'not found' || true
    exit 1
fi
build-info "Converted test.svg to PNG successfully"

exit 0
